library(geobr)
library(ggplot2)
library(dplyr)
library(sf)
library(leaflet)
library(htmltools)
#rm(list = ls())
#dados <- read.table("clipboard", h = TRUE, sep = "\t")
total_alunos <- 910
# 1. contagem por UF
freq_uf <- dados %>%
mutate(UF = toupper(trimws(NATURALIDADE_UF))) %>%
dplyr::count(UF, name = "frequencia") %>%
arrange(desc(frequencia))
# 2. geometrias das UFs
estados <- read_state(year = 2020, showProgress = FALSE, cache = FALSE)
estados <- estados %>%
mutate(UF = toupper(abbrev_state)) %>%
left_join(freq_uf, by = "UF") %>%
mutate(frequencia = ifelse(is.na(frequencia), 0, frequencia))
# 3. faixas iguais às do TO (mesma escala)
estados <- estados %>%
mutate(
percentual = round(100 * frequencia / total_alunos, 1),
faixa = cut(
frequencia,
breaks = c(-1, 0, 1, 3, 5, 10, 20, 50, 100, Inf),
labels = c("0", "1", "2-3", "4-5", "6-10",
"11-20", "21-50", "51-100", ">100"),
right = TRUE, include.lowest = TRUE
),
faixa_letra = factor(letters[as.integer(faixa)], levels = letters[1:9])
)
# 4. paleta idêntica à do TO
pal <- colorFactor(
palette = c("white", "#fee5d9", "#fcae91", "#fb6a4a",
"#de2d26", "#a50f15", "#7f0000", "#4d0000", "black"),
domain  = letters[1:9],
na.color = "gray90"
)
# 5. tooltip
estados$tooltip <- paste0(
"<b>", estados$name_state, " (", estados$UF, ")</b><br/>",
"Frequência: ", estados$frequencia, "<br/>",
"Percentual: ", estados$percentual, "%"
)
# 6. leaflet
estados <- st_transform(estados, 4326)
mapa_ufs=leaflet(estados, options = leafletOptions(minZoom = 4)) %>%
addProviderTiles("Esri.WorldGrayCanvas") %>%
addPolygons(
fillColor   = ~pal(faixa_letra),
fillOpacity = 0.9,
color       = "black",
weight      = 0.5,
label       = ~lapply(tooltip, HTML),
labelOptions = labelOptions(
style = list("font-size" = "30px", "font-family" = "Times New Roman, Times, serif"),
direction = "auto")
) %>%
addLegend(
pal    = pal,
values = ~faixa_letra,
title  = "Frequência",
labFormat = function(type, cuts, p) {
c("0", "1", "2-3", "4-5", "6-10",
"11-20", "21-50", "51-100", ">100")
},
position = "bottomright"
)

)
# 4. paleta idêntica à do TO
pal <- colorFactor(
palette = c("white", "#fee5d9", "#fcae91", "#fb6a4a",
"#de2d26", "#a50f15", "#7f0000", "#4d0000", "black"),
domain  = letters[1:9],
na.color = "gray90"
)
# 5. tooltip
estados$tooltip <- paste0(
"<b>", estados$name_state, " (", estados$UF, ")</b><br/>",
"Frequência: ", estados$frequencia, "<br/>",
"Percentual: ", estados$percentual, "%"
)
# 6. leaflet
estados <- st_transform(estados, 4326)
mapa_ufs=leaflet(estados, options = leafletOptions(minZoom = 4)) %>%
addProviderTiles("Esri.WorldGrayCanvas") %>%
addPolygons(
fillColor   = ~pal(faixa_letra),
fillOpacity = 0.9,
color       = "black",
weight      = 0.5,
label       = ~lapply(tooltip, HTML),
labelOptions = labelOptions(
style = list("font-size" = "20px", "font-family" = "Times New Roman, Times, serif"),
direction = "auto")
) %>%
addLegend(
pal    = pal,
values = ~faixa_letra,
title  = "Frequência",
labFormat = function(type, cuts, p) {
c("0", "1", "2-3", "4-5", "6-10",
"11-20", "21-50", "51-100", ">100")
},
position = "bottomright"
)
library(htmlwidgets)
saveWidget(mapa_to,  file = "mapa_to.html",  selfcontained = F)
saveWidget(mapa_ufs, file = "mapa_ufs.html", selfcontained = F)

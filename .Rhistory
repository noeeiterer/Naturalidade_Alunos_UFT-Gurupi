rm(list=ls())
dados<-read.table("clipboard",h=T,sep="\t")
total_alunos <- 910
head(dados)
normalizar <- function(x) {
x <- toupper(trimws(x))
x <- iconv(x, from = "UTF-8", to = "ASCII//TRANSLIT")  # remove acentos e Ç
x <- gsub("[^A-Z0-9 ]", "", x)                          # remove pontuação
x <- gsub("\\s+", " ", x)                               # espaços duplos
trimws(x)}
freq <- data.frame(nome = toupper(trimws(normalizar(dados$NATURALIDADE))))
freq=freq %>%
dplyr::count(nome, name = "frequencia")
municipios <- read_municipality(code_muni = "TO", year = 2020, showProgress = FALSE) %>%
mutate(nome = normalizar(name_muni)) %>%
left_join(freq, by = "nome")
municipios$frequencia[is.na(municipios$frequencia)] <- 0
to <- municipios %>% filter(abbrev_state == "TO")
# preparar dados do TO com percentual e cor
to_leaf <- to %>%
mutate(
percentual = round(100 * frequencia / total_alunos, 1),
faixa = cut(
frequencia,
breaks = c(-1, 0, 1, 3, 5, 10, 20, 50, 100, Inf),
labels = c("0", "1", "2-3", "4-5", "6-10",
"11-20", "21-50", "51-100", ">100"),
right  = TRUE,
include.lowest = TRUE
),
faixa_letra = factor(letters[as.integer(faixa)], levels = letters[1:9])
)
pal <- colorFactor(
palette = c("white", "#fee5d9", "#fcae91", "#fb6a4a",
"#de2d26", "#a50f15", "#7f0000", "#4d0000", "black"),
domain  = letters[1:9],
na.color = "gray90"
)
to_leaf$tooltip <- paste0(
"<b>", to_leaf$name_muni, "</b><br/>",
"Frequência: ", to_leaf$frequencia, "<br/>",
"Percentual: ", to_leaf$percentual, "%")
